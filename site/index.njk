---js
{
  title: "potterymaps – Keramik bemalen Studios finden",
  description: "potterymaps listet Studios zum Keramik bemalen. Wähle dein Land, um loszulegen.",
}
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}/">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preload" href="/fonts/fredoka-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="country-select">
    <a class="logo" href="/">{% optimizedImage "./images/logo.png", "potterymaps Logo", { widths: [452], formats: ["webp", "png"], sizes: "226px", loading: "eager", fetchpriority: "high", class: "logo-img" } %}</a>
    <h1>Wähle dein Land</h1>
    <p class="intro">potterymaps listet Studios zum Keramik bemalen – wähle dein Land, um loszulegen.</p>
    <div class="country-cards">
      <a class="country-card" href="/ch/">
        <span class="country-card-name">Schweiz</span>
        <span class="country-card-hint">Zum Verzeichnis →</span>
      </a>
      <div class="country-card country-card-disabled">
        <span class="country-card-name">Deutschland</span>
        <span class="country-card-hint">Bald verfügbar</span>
      </div>
    </div>
  </main>
  <footer class="site-footer country-select-footer">
    <nav>
      <a href="/ch/impressum/">Impressum</a>
      <a href="/ch/datenschutz/">Datenschutzerklärung</a>
    </nav>
    <p>&copy; {{ year }} potterymaps</p>
  </footer>
</body>
</html>
