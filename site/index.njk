---js
{
  layout: "base.njk",
  title: "Keramik bemalen Schweiz – Studios in deiner Stadt finden | potterymaps",
  description: "Finde Studios zum Keramik bemalen in der ganzen Schweiz – Teller, Ton und Porzellan bemalen, plus gemütliche Keramik-Cafés. Alle Städte im Überblick.",
  eleventyComputed: {
    popularCities: (data) => {
      return [...(data.cities || [])].sort((a, b) => b.count - a.count);
    },
    exampleStudios: (data) => {
      // Studios mit eigenem Bild zuerst (stabile Sortierung: sonstige Reihenfolge
      // innerhalb der beiden Gruppen bleibt erhalten), damit die begrenzte Auswahl
      // hochwertiger wirkt, solange erst wenige Studios ein Bild hinterlegt haben.
      return (data.studios || [])
        .filter((s) => s.priceRangeText && s.topTags.length)
        .sort((a, b) => (b.image ? 1 : 0) - (a.image ? 1 : 0))
        .slice(0, 6);
    },
    cafeStudios: (data) => {
      return (data.studios || [])
        .filter((s) => /café|cafe/i.test(s.description || ""))
        .sort((a, b) => (b.image ? 1 : 0) - (a.image ? 1 : 0))
        .slice(0, 3);
    },
    porzellanStudios: (data) => {
      return (data.studios || [])
        .filter((s) => /porzellan/i.test(s.description || ""))
        .sort((a, b) => (b.image ? 1 : 0) - (a.image ? 1 : 0))
        .slice(0, 3);
    },
    heroImageUrl: async () => {
      const Image = require("@11ty/eleventy-img").default;
      const metadata = await Image("./images/hero-keramik.jpg", {
        widths: [1600],
        formats: ["webp"],
        outputDir: "./_site/images/optimized/",
        urlPath: "/images/optimized/",
      });
      return metadata.webp[0].url;
    },
  },
}
---
{% from "studio-card.njk" import card %}
<article class="home">

  <section class="hero" style="background-image: url('{{ heroImageUrl }}');">
    <h1>Finde dein Studio zum Keramik bemalen</h1>
    <p class="intro">Studios und Ateliers in der ganzen Schweiz – nach Stadt sortiert, mit Preisen und Öffnungszeiten auf einen Blick.</p>
    <div class="city-search-wrap">
      <form class="city-search" id="city-search-form" autocomplete="off">
        <input type="text" id="city-search-input" placeholder="Wo möchtest du Keramik bemalen?" aria-label="Stadt suchen">
        <button type="submit">Suchen</button>
      </form>
      <div class="city-suggestions" id="city-suggestions" hidden></div>
    </div>
  </section>

  <section class="stats-box">
    <div class="stat"><i class="ti ti-building"></i><strong>{{ studios.length }}</strong><span>{{ pluralize(studios.length, "Studio", "Studios") }}</span></div>
    <div class="stat-divider"></div>
    <div class="stat"><i class="ti ti-map-pin"></i><strong>{{ cities.length }}</strong><span>Städte</span></div>
  </section>

  <section class="topic-intro">
    <h2>Teller, Ton oder Porzellan bemalen – oder einfach im Keramik-Café verweilen</h2>
    <p>Bei potterymaps geht es um mehr als klassisches Keramik bemalen: Viele Studios bieten auch das Bemalen von Porzellan an{% if porzellanStudios.length %}, zum Beispiel {% for s in porzellanStudios %}<a href="/studio/{{ s.slug }}/">{{ s.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}. Andere sind gemütliche Keramik-Cafés, in denen du bei einer Tasse Kaffee direkt vor Ort einen Teller zum Bemalen aussuchst oder dein Stück aus Ton bemalst{% if cafeStudios.length %} – etwa bei {% for s in cafeStudios %}<a href="/studio/{{ s.slug }}/">{{ s.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}. Wähle unten deine Stadt und finde das passende Studio in deiner Nähe.</p>
  </section>

  <section class="how-it-works">
    <h2>So funktioniert's</h2>
    <ol class="steps">
      <li><span class="step-num">1</span><strong>Stadt wählen</strong><p>Finde alle Studios in deiner Nähe.</p></li>
      <li><span class="step-num">2</span><strong>Studio vergleichen</strong><p>Preise, Öffnungszeiten und Tags auf einen Blick.</p></li>
      <li><span class="step-num">3</span><strong>Termin buchen</strong><p>Direkt beim Studio per Telefon, E-Mail oder Website.</p></li>
    </ol>
  </section>

  <section class="example-studios">
    <h2>Studios entdecken</h2>
    <ul class="studio-cards">
      {% for s in exampleStudios %}{{ card(s) }}{% endfor %}
    </ul>
  </section>

  <section class="cta-events">
    <h2>Grössere Events planen?</h2>
    <p>Firmenanlass, Kindergeburtstag oder Junggesellinnenabschied – wir vermitteln dich an ein passendes Studio.</p>
    <a class="button" href="/events/">Grössere Events planen?</a>
  </section>

  <section class="view-all-link">
    <a href="/alle-staedte/">Alle Städte & Karte ansehen →</a>
  </section>

  <section class="cta-missing">
    <h2>Dein Studio fehlt?</h2>
    <p>Wir wachsen laufend weiter. Kennst du ein Studio, das noch nicht gelistet ist?</p>
    <a class="button" href="/studio-eintragen/">Trag es ein</a>
  </section>

</article>
<script>
  (function () {
    var cities = [
      {% for c in popularCities %}{ name: "{{ c.name | escape }}", slug: "{{ c.slug }}" }{% if not loop.last %},{% endif %}
      {% endfor %}
    ];
    var input = document.getElementById("city-search-input");
    var box = document.getElementById("city-suggestions");
    var form = document.getElementById("city-search-form");
    var activeIndex = -1;

    function render(matches) {
      box.innerHTML = "";
      activeIndex = -1;
      if (!matches.length) {
        box.hidden = true;
        return;
      }
      matches.slice(0, 6).forEach(function (c) {
        var a = document.createElement("a");
        a.href = "/staedte/" + c.slug + "/";
        if (c.note) {
          a.innerHTML = c.name + ' <span class="suggestion-note">' + c.note + "</span>";
        } else {
          a.textContent = c.name;
        }
        box.appendChild(a);
      });
      box.hidden = false;
    }

    function currentMatches() {
      var q = input.value.trim().toLowerCase();
      if (!q) return [];
      return cities.filter(function (c) { return c.name.toLowerCase().indexOf(q) !== -1; });
    }

    input.addEventListener("input", function () {
      render(currentMatches());
    });

    input.addEventListener("keydown", function (e) {
      var links = box.querySelectorAll("a");
      if (e.key === "ArrowDown" && links.length) {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % links.length;
        links.forEach(function (l, i) { l.classList.toggle("active", i === activeIndex); });
      } else if (e.key === "ArrowUp" && links.length) {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + links.length) % links.length;
        links.forEach(function (l, i) { l.classList.toggle("active", i === activeIndex); });
      } else if (e.key === "Escape") {
        box.hidden = true;
      }
    });

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var links = box.querySelectorAll("a");
      if (activeIndex >= 0 && links[activeIndex]) {
        window.location.href = links[activeIndex].getAttribute("href");
        return;
      }
      var matches = currentMatches();
      if (matches.length) {
        window.location.href = "/staedte/" + matches[0].slug + "/";
      }
    });

    document.addEventListener("click", function (e) {
      if (!box.contains(e.target) && e.target !== input) box.hidden = true;
    });
  })();
</script>
