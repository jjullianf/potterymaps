---js
{
  pagination: {
    data: "nearbyTowns",
    size: 1,
    alias: "town",
  },
  permalink: (data) => `/ch/studios-nahe/${data.town.slug}/`,
  layout: "base.njk",
  eleventyComputed: {
    title: (data) => `Keramik bemalen ${data.town.name} - Studios in der Nähe | potterymaps`,
    description: (data) => `In ${data.town.name} gibt es aktuell kein eigenes Keramik-Bemalen-Studio. Die nächstgelegenen Studios inkl. Distanz und Preisen findest du hier.`,
    jsonLdBreadcrumb: (data) => ({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Startseite", item: `${data.site.url}/ch/` },
        { "@type": "ListItem", position: 2, name: "Alle Städte", item: `${data.site.url}/ch/alle-staedte/` },
        { "@type": "ListItem", position: 3, name: data.town.name, item: `${data.site.url}/ch/studios-nahe/${data.town.slug}/` },
      ],
    }),
    jsonLdItemList: (data) =>
      data.town.nearestStudios.length
        ? {
            "@context": "https://schema.org",
            "@type": "ItemList",
            itemListElement: data.town.nearestStudios.map((s, i) => ({
              "@type": "ListItem",
              position: i + 1,
              name: s.name,
              url: `${data.site.url}/ch/studio/${s.slug}/`,
            })),
          }
        : null,
  },
}
---
{% from "studio-card.njk" import card %}
{% set t = town %}
<article class="city-page">
  <p class="breadcrumb"><a href="/ch/">Startseite</a> &raquo; <a href="/ch/alle-staedte/">Alle Städte</a> &raquo; {{ t.name }}</p>

  <div class="city-header city-header-placeholder">
    <h1>Keramik bemalen in der Nähe von {{ t.name }}</h1>
  </div>

  <p class="city-intro">In {{ t.name }} selbst gibt es aktuell kein Keramik-Bemalen-Studio. Die nächstgelegenen Studios sind:
    {% for s in t.nearestStudios %}<a href="/ch/studio/{{ s.slug }}/">{{ s.name }}</a> in {{ s.city }} ({{ s.distanceKm }} km){% if not loop.last %}, {% endif %}{% endfor %}.
  </p>

  {% if t.nearestStudios.length %}
  <div class="map-consent-gate leaflet-consent-gate" data-init-fn="__initTownMap">
    <p>Für die Karte wird eine Verbindung zu OpenStreetMap-Kartenservern hergestellt, wobei deine IP-Adresse übermittelt wird.</p>
    <button type="button" class="button map-consent-load-btn">Karte laden</button>
    <div class="leaflet-consent-target" hidden>
      <div id="city-detail-map" class="city-detail-map"></div>
    </div>
  </div>
  <section class="studio-list">
    <h2>Studios in der Nähe von {{ t.name }}</h2>
    <ul class="studio-cards">
      {% for s in t.nearestStudios %}{{ card(s) }}{% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if t.nearestCitySlug %}
  <section class="nearby-towns">
    <h2>Alle Studios in der Region</h2>
    <p>Eine vollständige Übersicht der Studios rund um {{ t.name }} findest du auf der Seite von <a href="/ch/staedte/{{ t.nearestCitySlug }}/">{{ t.nearestCityName }}</a>.</p>
  </section>
  {% endif %}

  <section class="cta-missing">
    <h2>Studio in {{ t.name }} fehlt?</h2>
    <p>Kennst du ein Studio zum Keramik bemalen in {{ t.name }}, das hier noch nicht gelistet ist?</p>
    <a class="button" href="/ch/studio-eintragen/">Trag es ein</a>
  </section>
</article>

{% if t.nearestStudios.length %}
<script>
  window.__initTownMap = function () {
    var town = { lat: {{ t.lat }}, lng: {{ t.lng }} };
    var studios = [
      {% for s in t.nearestStudios %}
      { name: "{{ s.name | escape }}", slug: "{{ s.slug }}", lat: {{ s.lat }}, lng: {{ s.lng }} }{% if not loop.last %},{% endif %}
      {% endfor %}
    ];

    var map = L.map('city-detail-map', { scrollWheelZoom: false }).setView([town.lat, town.lng], 10);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>-Mitwirkende',
      maxZoom: 18,
      className: "map-tiles-muted",
    }).addTo(map);

    var townIcon = L.divIcon({
      className: "map-marker-dot-wrap",
      html: '<div class="map-marker-dot map-marker-dot-town"></div>',
      iconSize: [14, 14],
    });
    L.marker([town.lat, town.lng], { icon: townIcon }).addTo(map).bindPopup("<strong>{{ t.name | escape }}</strong>");

    var dotIcon = L.divIcon({
      className: "map-marker-dot-wrap",
      html: '<div class="map-marker-dot"></div>',
      iconSize: [14, 14],
    });

    studios.forEach(function (s) {
      L.marker([s.lat, s.lng], { icon: dotIcon }).addTo(map).bindPopup(
        '<strong>' + s.name + '</strong><br><a href="/ch/studio/' + s.slug + '/">Zur Studio-Seite</a>'
      );
    });
  };
</script>
{% endif %}
