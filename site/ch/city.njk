---js
{
  pagination: {
    data: "allCities",
    size: 1,
    alias: "cityData",
  },
  // Land direkt aus dem Eintrag: permalink wird vor eleventyComputed ausgewertet.
  permalink: (data) => `${data.cityData.country.path}/staedte/${data.cityData.slug}/`,
  layout: "base.njk",
  eleventyComputed: {
    country: (data) => data.cityData.country,
    title: (data) => (data.cityData.insights ? data.cityData.insights.title : `Keramik bemalen ${data.cityData.name} - ${data.cityData.count} ${data.pluralize(data.cityData.count, "Atelier", "Ateliers")} im Vergleich | potterymaps`),
    jsonLdFaq: (data) => (data.cityData.insights ? data.cityData.insights.jsonLdFaq : null),
    description: (data) => (data.cityData.insights ? data.cityData.insights.description : `Keramik bemalen in ${data.cityData.name}: Ateliers für Teller-, Ton- und Porzellan bemalen sowie Keramik-Cafés – mit Preisen und Öffnungszeiten auf einen Blick.`),
    noindex: (data) => data.cityData.noindex,
    jsonLdItemList: (data) => data.cityData.jsonLdItemList,
    jsonLdBreadcrumb: (data) => data.cityData.jsonLdBreadcrumb,
    // Nur die 4 naechstgelegenen Orte ohne eigenes Atelier anzeigen (Datengrundlage
    // in nearbyTowns bleibt vollstaendig - hier wird nur die Anzeige begrenzt).
    townsWithoutStudio: (data) =>
      (data.nearbyTowns || [])
        .filter((t) => t.nearestCitySlug === data.cityData.slug)
        .sort((a, b) => a.nearestCityDistanceKm - b.nearestCityDistanceKm)
        .slice(0, 4),
    mapStudiosForJs: (data) =>
      (data.cityData.mapStudios || []).map((s) => ({ lat: s.lat, lng: s.lng, popupHtml: s.mapPopupHtmlCompact })),
  },
}
---
{% from "studio-card.njk" import card %}
{% set c = cityData %}
<article class="city-page">
  <p class="breadcrumb"><a href="{{ country.path }}/">Startseite</a> &raquo; <a href="{{ country.path }}/alle-staedte/">Alle Städte</a> &raquo; {{ c.name }}</p>

  <div class="city-header{% if not c.hasPhoto %} city-header-placeholder{% endif %}">
    {% if c.hasPhoto %}{% optimizedImage "./images/cities/" + c.slug + ".jpg", "Stadtansicht von " + c.name, { widths: [500, 852], sizes: "(max-width: 900px) 100vw, 852px", loading: "eager", fetchpriority: "high", class: "city-header-img" } %}{% endif %}
    <h1>Keramik bemalen {{ c.name }}</h1>
  </div>

  {% if c.insights %}
  <p class="city-intro">{% if c.insights.lead %}{{ c.insights.lead }} {% endif %}{{ c.insights.summary }}</p>
  {% else %}
  <p class="city-intro">{{ c.intro }}{% if c.introDynamic %} {{ c.introDynamic }}{% endif %}</p>
  {% endif %}

  {% if c.hasAny and (c.cafeMatch or c.porzellanMatch) %}
  <p class="city-topic-intro">
    {% if c.porzellanMatch %}Auch Porzellan bemalen ist in {{ c.name }} möglich, z. B. bei <a href="{{ country.path }}/studio/{{ c.porzellanMatch.slug }}/">{{ c.porzellanMatch.name }}</a>.{% endif %}
    {% if c.cafeMatch %}Wer es gemütlich mag, findet mit <a href="{{ country.path }}/studio/{{ c.cafeMatch.slug }}/">{{ c.cafeMatch.name }}</a> auch ein Keramik-Café in {{ c.name }}.{% endif %}
  </p>
  {% endif %}

  {% if c.mapStudios.length %}
  <div class="map-consent-gate leaflet-consent-gate" data-init-fn="__initCityMap">
    <p>Für die Karte wird eine Verbindung zu OpenStreetMap-Kartenservern hergestellt, wobei deine IP-Adresse übermittelt wird.</p>
    <button type="button" class="button map-consent-load-btn">Karte laden</button>
    <div class="leaflet-consent-target" hidden>
      <div id="city-detail-map" class="city-detail-map"></div>
    </div>
  </div>
  {% endif %}

  {% if c.direct.length %}
  <section class="studio-list">
    <h2>Ateliers in {{ c.name }}</h2>
    <ul class="studio-cards">
      {% for s in c.direct %}{{ card(s) }}{% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if c.insights %}
  <section class="city-facts">
    <h2>Keramik bemalen in {{ c.name }} auf einen Blick</h2>
    <ul class="city-facts-list">
      {% for f in c.insights.facts %}<li>{{ f }}</li>{% endfor %}
    </ul>
  </section>

  {% if c.insights.table.length > 1 %}
  <section class="city-compare">
    <h2>Ateliers in {{ c.name }} im Vergleich</h2>
    <div class="city-compare-scroll">
      <table>
        <thead><tr><th>Atelier</th><th>Preis</th><th>Termin</th><th>Kinder</th><th>Gruppen</th></tr></thead>
        <tbody>
          {% for r in c.insights.table %}
          <tr><td><a href="{{ r.url }}">{{ r.name }}</a></td><td>{{ r.price or "–" }}</td><td>{{ r.booking or "–" }}</td><td>{{ r.kids or "–" }}</td><td>{{ r.groups or "–" }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="city-compare-note">Angaben laut Websites der Ateliers. Preise und Zeiten können sich ändern, bitte vor dem Besuch kurz prüfen.</p>
  </section>
  {% endif %}

  {% if c.insights.faqs.length %}
  <section class="city-faq">
    <h2>Häufige Fragen zu Keramik bemalen in {{ c.name }}</h2>
    {% for f in c.insights.faqs %}
    <div class="faq-item">
      <h3 class="faq-q">{{ f.q }}</h3>
      <p>{{ f.a }}</p>
    </div>
    {% endfor %}
  </section>
  {% endif %}
  {% endif %}

  {% if c.nearbyTowns.length %}
  <section class="nearby-towns">
    <h2>Auch in der Nähe</h2>
    <ul class="town-chips">
      {% for t in c.nearbyTowns %}
      <li><a class="town-chip" href="{{ country.path }}/staedte/{{ t.slug }}/">{{ t.name }} <span class="count">{{ t.count }} {{ pluralize(t.count, "Atelier", "Ateliers") }}</span></a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if townsWithoutStudio.length %}
  <section class="nearby-towns">
    <h2>Weitere Orte in der Region</h2>
    <ul class="town-chips">
      {% for t in townsWithoutStudio %}
      <li><a class="town-chip" href="{{ country.path }}/studios-nahe/{{ t.slug }}/">{{ t.name }}</a></li>
      {% endfor %}
    </ul>
    <a class="back-to-map-link" href="{{ country.path }}/karte/">← Zurück zur Karte</a>
  </section>
  {% endif %}

  {% if c.insights and c.insights.otherCities.length %}
  <section class="nearby-towns">
    <h2>Keramik bemalen in anderen Städten</h2>
    <ul class="town-chips">
      {% for t in c.insights.otherCities %}
      <li><a class="town-chip" href="{{ country.path }}/staedte/{{ t.slug }}/">{{ t.name }} <span class="count">{{ t.count }} {{ pluralize(t.count, "Atelier", "Ateliers") }}</span></a></li>
      {% endfor %}
    </ul>
    <a class="back-to-map-link" href="{{ country.path }}/alle-staedte/">Alle Städte ansehen →</a>
  </section>
  {% endif %}

  {% if not c.hasAny %}
  <section class="empty-city">
    <p>Aktuell ist uns in {{ c.name }} noch kein Atelier zum Keramik bemalen bekannt.</p>
    <p>Kennst du ein Atelier hier? <a href="{{ country.path }}/studio-eintragen/">Trag es ein</a> und hilf mit, das Verzeichnis zu vervollständigen.</p>
  </section>
  {% else %}
  <section class="cta-events">
    <h2>Event in {{ c.name }} planen?</h2>
    <p>Firmenanlass, Weihnachts-Teamevent, Kindergeburtstag oder Junggesellinnenabschied – wir vermitteln dich kostenlos an ein passendes Atelier in {{ c.name }}.</p>
    <a class="button" href="{{ country.eventFormPath }}" data-umami-event="event-cta-click" data-umami-event-quelle="stadtseite">Event anfragen</a>
  </section>
  <section class="cta-missing">
    <h2>Dein Atelier fehlt?</h2>
    <p>Wir wachsen laufend weiter. Kennst du ein weiteres Atelier in {{ c.name }}, das hier noch nicht gelistet ist?</p>
    <a class="button" href="{{ country.path }}/studio-eintragen/">Trag es ein</a>
  </section>
  {% endif %}
</article>

{% if c.mapStudios.length %}
<script>
  window.__initCityMap = function () {
    var townCenter = { lat: {{ c.lat }}, lng: {{ c.lng }} };
    var studios = {{ mapStudiosForJs | dump | safe }};

    // Fester Zoom auf das Stadtzentrum statt fitBounds, damit weiter entfernte
    // Nachbarschafts-Ateliers die Karte nicht auf ganze Region herauszoomen lassen -
    // es soll nur die Stadt selbst sichtbar sein.
    var map = L.map('city-detail-map', { scrollWheelZoom: false }).setView([townCenter.lat, townCenter.lng], 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>-Mitwirkende',
      maxZoom: 18,
      className: "map-tiles-muted",
    }).addTo(map);

    var townIcon = L.divIcon({
      className: "map-marker-dot-wrap",
      html: '<div class="map-marker-dot map-marker-dot-town"></div>',
      iconSize: [14, 14],
    });
    L.marker([townCenter.lat, townCenter.lng], { icon: townIcon }).addTo(map).bindPopup("<strong>{{ c.name | escape }}</strong>");

    var dotIcon = L.divIcon({
      className: "map-marker-dot-wrap",
      html: '<div class="map-marker-dot"></div>',
      iconSize: [14, 14],
    });

    studios.forEach(function (s) {
      var marker = L.marker([s.lat, s.lng], { icon: dotIcon }).addTo(map).bindPopup(s.popupHtml);
      window.potterymapsAttachHoverPopup(marker);
    });
  };
</script>
{% endif %}
