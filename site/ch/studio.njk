---js
{
  pagination: {
    data: "allStudios",
    size: 1,
    alias: "studio",
  },
  // Land direkt aus dem Eintrag: permalink wird vor eleventyComputed ausgewertet.
  permalink: (data) => `${data.studio.countryConfig.path}/studio/${data.studio.slug}/`,
  layout: "base.njk",
  eleventyComputed: {
    country: (data) => data.studio.countryConfig,
    title: (data) => `${data.studio.name} – Keramik bemalen in ${data.studio.city} | potterymaps`,
    description: (data) => `${data.studio.name} in ${data.studio.city}: ${data.studio.address}. Öffnungszeiten, Preise und Infos zum Keramik bemalen.`,
    jsonLd: (data) => {
      const s = data.studio;
      return {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        name: s.name,
        description: s.description || undefined,
        address: {
          "@type": "PostalAddress",
          streetAddress: s.address,
          postalCode: s.postcode || undefined,
          addressLocality: s.city,
          addressRegion: s.region || undefined,
          addressCountry: s.country || "CH",
        },
        openingHours: s.opening_hours || undefined,
        priceRange: (s.price_mug || s.price_plate) ? `${s.price_mug || ""}–${s.price_plate || ""} ${s.currency || "CHF"}` : undefined,
        telephone: s.phone || undefined,
        email: s.email || undefined,
        url: s.website || undefined,
        sameAs: s.instagramUrl ? [s.instagramUrl] : undefined,
      };
    },
    jsonLdBreadcrumb: (data) => {
      const s = data.studio;
      const url = data.site.url;
      return {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Startseite", item: `${url}${data.country.path}/` },
          { "@type": "ListItem", position: 2, name: "Alle Städte", item: `${url}${data.country.path}/alle-staedte/` },
          { "@type": "ListItem", position: 3, name: s.targetCityName, item: `${url}${data.country.path}/staedte/${s.targetCitySlug}/` },
          { "@type": "ListItem", position: 4, name: s.name, item: `${url}${data.country.path}/studio/${s.slug}/` },
        ],
      };
    },
    jsonLdFaq: (data) => {
      const s = data.studio;
      if (!s.faqs || !s.faqs.length) return null;
      return {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: s.faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: {
            "@type": "Answer",
            text: f.a,
          },
        })),
      };
    },
    similarStudios: (data) => {
      const s = data.studio;
      const all = data.studios || [];
      // Ateliers mit eigenem Bild zuerst (stabile Sortierung), damit die kleine
      // Auswahl von nur 3-4 Eintraegen hochwertiger wirkt, solange erst wenige
      // Ateliers ein Bild hinterlegt haben.
      const imageFirst = (arr) => [...arr].sort((a, b) => (b.image ? 1 : 0) - (a.image ? 1 : 0));
      const sameLiteralCity = all.filter((o) => o.slug !== s.slug && o.city === s.city);
      if (sameLiteralCity.length > 0) return imageFirst(sameLiteralCity).slice(0, 3);
      // Kein weiteres Atelier am exakt gleichen Ort: auf Ateliers im Naehe-Cluster
      // (gleiche naechste der 20 Hauptstaedte) ausweichen ("Nachbarschaft").
      const cluster = all.filter((o) => o.slug !== s.slug && o.nearestHubSlug === s.nearestHubSlug);
      return imageFirst(cluster).slice(0, 3);
    },
  },
}
---
{% from "studio-card.njk" import card %}
{% set s = studio %}
<article class="studio-detail">
  <p class="breadcrumb"><a href="{{ country.path }}/">Startseite</a> &raquo; <a href="{{ country.path }}/alle-staedte/">Alle Städte</a> &raquo; <a href="{{ country.path }}/staedte/{{ s.targetCitySlug }}/">{{ s.targetCityName }}</a> &raquo; {{ s.name }}</p>

  <h1 class="studio-title">{{ s.name }}{% if s.featured %} <span class="featured-badge">Empfohlen</span>{% endif %}</h1>

  <div class="studio-hero">
    <div class="studio-hero-main">
      <div class="glance">
        <div class="glance-grid">
          {% if s.glance.price %}
          <div class="fact fact-price"><div class="fact-k"><i class="ti ti-tag"></i>Preis</div><div class="fact-v">{{ s.glance.price.value }}</div>{% if s.glance.price.sub %}<div class="fact-s">{{ s.glance.price.sub }}</div>{% endif %}</div>
          {% endif %}
          {% if s.glance.termin %}
          <div class="fact{% if s.glance.termin.green %} fact-green{% endif %}"><div class="fact-k"><i class="ti ti-door-enter"></i>Termin</div><div class="fact-v">{{ s.glance.termin.value }}</div><div class="fact-s">{{ s.glance.termin.sub }}</div></div>
          {% endif %}
          {% if s.glance.hours %}
          <div class="fact"><div class="fact-k"><i class="ti ti-clock"></i>Öffnungszeiten</div><div class="fact-v">{{ s.glance.hours.value }}</div>{% if s.glance.hours.sub %}<div class="fact-s">{{ s.glance.hours.sub }}</div>{% endif %}</div>
          {% endif %}
          {% if s.glance.pickup %}
          <div class="fact"><div class="fact-k"><i class="ti ti-package"></i>Abholzeit</div><div class="fact-v">{{ s.glance.pickup.value }}</div>{% if s.glance.pickup.sub %}<div class="fact-s">{{ s.glance.pickup.sub }}</div>{% endif %}</div>
          {% endif %}
        </div>
        <div class="glance-actions">
          {% if s.phone %}<a class="glance-btn glance-btn-primary" href="tel:{{ s.phone }}"><i class="ti ti-phone"></i>Anrufen</a>{% endif %}
          <a class="glance-btn" href="https://www.google.com/maps/dir/?api=1&destination={{ (s.address + ' ' + s.city) | urlencode }}" target="_blank" rel="noopener"><i class="ti ti-map-pin"></i>Route</a>
          {% if s.website %}<a class="glance-btn studio-website-link" href="{{ s.website | withUtm }}" rel="nofollow noopener" target="_blank" data-studio-slug="{{ s.slug }}" data-studio-name="{{ s.name | e }}"><i class="ti ti-world"></i>Website</a>{% endif %}
        </div>
        <p class="glance-more">Mehr Details weiter unten <i class="ti ti-arrow-down"></i></p>
      </div>

      {% if s.tagsObjectsNoWalkin.length %}
      <div class="tags tags-small">
        {% for tag in s.tagsObjectsNoWalkin %}<span class="tag tag-{{ tag.category }}"><i class="ti {{ tag.icon }}"></i>{{ tag.label }}</span>{% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="studio-hero-image">
      {% studioGallery s.images, s.name %}
    </div>
  </div>

  {% if s.description %}<p class="studio-description">{{ s.description | linkify | safe }}</p>{% endif %}

  {% if s.opening_hours or s.price_note or s.pickup_time or s.special_events %}
  <section class="studio-info">
    <h2>Weitere Infos</h2>
    <ul>
      {% if s.opening_hours %}<li><strong>Öffnungszeiten:</strong> {{ s.opening_hours | linkify | safe }}</li>{% endif %}
      {% if s.price_note %}<li>{{ s.price_note | linkify | safe }}</li>{% endif %}
      {% if s.pickup_time %}<li><strong>Abholzeit:</strong> {{ s.pickup_time | linkify | safe }}</li>{% endif %}
      {% if s.special_events %}<li><strong>Besondere Events:</strong> {{ s.special_events | linkify | safe }}</li>{% endif %}
    </ul>
  </section>
  {% endif %}

  <p class="studio-address"><i class="ti ti-map-pin"></i> {{ s.address }}</p>
  <div class="studio-map">
    <div class="map-consent-gate" data-map-src="https://www.google.com/maps?q={{ (s.address + ' ' + s.city) | urlencode }}&output=embed" data-map-title="Karte: {{ s.name }}">
      <p>Für die Karte wird eine Verbindung zu Google Maps hergestellt.</p>
      <button type="button" class="button map-consent-load-btn">Karte laden</button>
    </div>
  </div>

  <section class="studio-contact">
    <h2>Kontakt</h2>
    <ul>
      {% if s.phone %}<li><strong>Telefon:</strong> <a href="tel:{{ s.phone }}">{{ s.phone }}</a></li>{% endif %}
      {% if s.email %}<li><strong>E-Mail:</strong> <a href="mailto:{{ s.email }}">{{ s.email }}</a></li>{% endif %}
      {% if s.instagramUrl %}<li><strong>Instagram:</strong> <a href="{{ s.instagramUrl }}" rel="nofollow noopener" target="_blank">@{{ s.instagramHandle }}</a></li>{% endif %}
      {% if s.website %}<li><strong>Website:</strong> <a href="{{ s.website | withUtm }}" rel="nofollow noopener" target="_blank" class="studio-website-link" data-studio-slug="{{ s.slug }}" data-studio-name="{{ s.name | escape }}">{{ s.website }}</a></li>{% endif %}
    </ul>
  </section>

  {% if s.faqs.length %}
  <section class="studio-faq">
    <h2>Häufige Fragen</h2>
    {% for f in s.faqs %}
    <div class="faq-item">
      <h3 class="faq-q">{{ f.q }}</h3>
      <p class="faq-a">{{ f.a | linkify | safe }}</p>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if similarStudios.length %}
  <section class="similar-studios">
    <h2>Ähnliche Ateliers in der Nähe</h2>
    <ul class="studio-cards">
      {% for other in similarStudios %}{{ card(other) }}{% endfor %}
    </ul>
  </section>
  {% endif %}

  <p class="back-to-city-link"><a href="{{ country.path }}/staedte/{{ s.targetCitySlug }}/">Alle Ateliers in {{ s.targetCityName }} ansehen →</a></p>

  <section class="report-error">
    <p class="studio-disclaimer">Alle Angaben ohne Gewähr. Sie stammen aus öffentlich zugänglichen Quellen, vor allem der Website des Ateliers. Bitte prüfe Preise, Öffnungszeiten und Verfügbarkeit direkt beim Atelier.</p>
    <p>Etwas an diesem Eintrag stimmt nicht mehr? <a href="{{ country.path }}/studio-eintragen/?studio={{ s.name | urlencode }}">Fehler gefunden? Melden</a></p>
  </section>
</article>
