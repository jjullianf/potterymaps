---js
{
  layout: "base.njk",
  title: "Karte aller Ateliers | potterymaps",
  description: "Alle Ateliers zum Keramik bemalen in der Schweiz auf einer Karte - finde ein Atelier in deiner Nähe.",
  permalink: "/ch/karte/",
  eleventyComputed: {
    mapStudios: (data) => (data.studios || []).filter((s) => s.lat && s.lng),
    mapStudiosForJs: (data) =>
      (data.studios || [])
        .filter((s) => s.lat && s.lng)
        .map((s) => ({ lat: s.lat, lng: s.lng, popupHtml: s.mapPopupHtml })),
  },
}
---
<article class="static-page">
  <p class="breadcrumb"><a href="/ch/">Startseite</a> &raquo; Karte</p>
  <h1>Alle Ateliers auf der Karte</h1>
  <p>Alle {{ mapStudios.length }} Ateliers zum Keramik bemalen in der Schweiz auf einen Blick. Klicke auf einen Pin für Details.</p>

  <div class="map-consent-gate leaflet-consent-gate" data-init-fn="__initKarteMap">
    <p>Für die Karte wird eine Verbindung zu OpenStreetMap-Kartenservern hergestellt, wobei deine IP-Adresse übermittelt wird.</p>
    <button type="button" class="button map-consent-load-btn">Karte laden</button>
    <div class="leaflet-consent-target" hidden>
      <div id="overview-map" class="overview-map"></div>
    </div>
  </div>
</article>

<script>
  window.__initKarteMap = function () {
    var studios = {{ mapStudiosForJs | dump | safe }};

    var map = L.map('overview-map').setView([46.9, 8.2], 8);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>-Mitwirkende',
      maxZoom: 18,
      className: "map-tiles-muted",
    }).addTo(map);

    var dotIcon = L.divIcon({
      className: "map-marker-dot-wrap",
      html: '<div class="map-marker-dot"></div>',
      iconSize: [14, 14],
    });

    var clusterGroup = L.markerClusterGroup({
      iconCreateFunction: function (cluster) {
        var count = cluster.getChildCount();
        var size = count < 10 ? 32 : count < 25 ? 40 : 48;
        return L.divIcon({
          html: '<div class="map-cluster-dot" style="width:' + size + 'px;height:' + size + 'px;">' + count + '</div>',
          className: "map-cluster-wrap",
          iconSize: L.point(size, size),
        });
      },
    });
    studios.forEach(function (s) {
      var marker = L.marker([s.lat, s.lng], { icon: dotIcon }).bindPopup(s.popupHtml);
      window.potterymapsAttachHoverPopup(marker);
      clusterGroup.addLayer(marker);
    });
    map.addLayer(clusterGroup);
  };
</script>
