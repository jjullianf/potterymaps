---js
{
  layout: "base.njk",
  title: "Alle Städte | potterymaps",
  pagination: { data: "countries", size: 1, alias: "country" },
  // Gleichwertige Seite in den anderen Laendern (hreflang), siehe base.njk
  pageKey: "alle-staedte/",
  permalink: (data) => `${data.country.path}/alle-staedte/`,
  eleventyComputed: {
    description: (data) => `Alle Orte im Verzeichnis für Keramik bemalen ${data.country.nameIn}, mit Anzahl gelisteter Ateliers und Übersichtskarte.`,
    sortedCities: (data) => [...(data.cities || [])].sort((a, b) => b.count - a.count),
    mapStudios: (data) => (data.studios || []).filter((s) => s.lat && s.lng),
    mapStudiosForJs: (data) =>
      (data.studios || [])
        .filter((s) => s.lat && s.lng)
        .map((s) => ({ lat: s.lat, lng: s.lng, popupHtml: s.mapPopupHtml })),
    jsonLdBreadcrumb: (data) => ({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Startseite", item: `${data.site.url}${data.country.path}/` },
        { "@type": "ListItem", position: 2, name: "Alle Städte", item: `${data.site.url}${data.country.path}/alle-staedte/` },
      ],
    }),
  },
}
---
<article class="static-page">
  <p class="breadcrumb"><a href="{{ country.path }}/">Startseite</a> &raquo; Alle Städte</p>
  <h1>Alle Städte</h1>
  <p>Alle {{ mapStudios.length }} {{ pluralize(mapStudios.length, "Atelier", "Ateliers") }} auf der Karte oder als Liste nach Stadt sortiert.</p>

  <div class="map-consent-gate leaflet-consent-gate" data-init-fn="__initAlleStaedteMap">
    <p>Für die Kartenübersicht wird eine Verbindung zu OpenStreetMap-Kartenservern hergestellt, wobei deine IP-Adresse übermittelt wird.</p>
    <button type="button" class="button map-consent-load-btn">Karte laden</button>
    <div class="leaflet-consent-target" hidden>
      <div id="overview-map" class="overview-map"></div>
    </div>
  </div>

  <ul class="all-cities-grid">
    {% for c in sortedCities %}
    <li id="city-card-{{ c.slug }}" class="{% if c.count == 0 %}city-card-empty{% endif %}">
      {% if c.count > 0 %}
      <a href="{{ country.path }}/staedte/{{ c.slug }}/">
        <span>{{ c.name }}</span>
        <span class="count">{{ c.count }} {{ pluralize(c.count, "Atelier", "Ateliers") }}</span>
      </a>
      {% else %}
      <div class="city-card-empty-inner">
        <span>{{ c.name }}</span>
        <a class="count zero" href="{{ country.path }}/studio-eintragen/">Noch kein Atelier – jetzt eintragen</a>
      </div>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</article>

<script>
  window.__initAlleStaedteMap = function () {
    var studios = {{ mapStudiosForJs | dump | safe }};

    var map = L.map('overview-map').setView([{{ country.mapView.lat }}, {{ country.mapView.lng }}], {{ country.mapView.zoom }});
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>-Mitwirkende',
      maxZoom: 18,
      className: "map-tiles-muted",
    }).addTo(map);

    var dotIcon = L.divIcon({
      className: "map-marker-dot-wrap",
      html: '<div class="map-marker-dot"></div>',
      iconSize: [14, 14],
    });

    var clusterGroup = L.markerClusterGroup({
      maxClusterRadius: 40,
      iconCreateFunction: function (cluster) {
        var count = cluster.getChildCount();
        var size = count < 10 ? 32 : count < 25 ? 40 : 48;
        return L.divIcon({
          html: '<div class="map-cluster-dot" style="width:' + size + 'px;height:' + size + 'px;">' + count + '</div>',
          className: "map-cluster-wrap",
          iconSize: L.point(size, size),
        });
      },
    });
    studios.forEach(function (s) {
      var marker = L.marker([s.lat, s.lng], { icon: dotIcon });
      window.potterymapsBindCard(marker, map, s.popupHtml);
      clusterGroup.addLayer(marker);
    });
    map.addLayer(clusterGroup);
    {% if country.mapFit %}if (studios.length) { map.fitBounds(clusterGroup.getBounds(), { padding: [40, 40], maxZoom: 11 }); }{% endif %}
  };
</script>
