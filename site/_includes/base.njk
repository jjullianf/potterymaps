<!DOCTYPE html>
<html lang="de-CH">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ canonicalUrl or (site.url + page.url) }}">
  {% if not noindex %}<link rel="alternate" hreflang="de-CH" href="{{ canonicalUrl or (site.url + page.url) }}">{% endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="potterymaps">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ ogImage or (site.url + '/images/hero-keramik.jpg') }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ ogImage or (site.url + '/images/hero-keramik.jpg') }}">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Fredoka jetzt self-hosted (site/fonts/) statt von Google Fonts geladen -
       kein preconnect zu fonts.g*.com mehr noetig. Preload, da die Schrift auf
       jeder Seite sofort gebraucht wird (h1/h2/Logo-Schriftzug etc.). -->
  <link rel="preload" href="/fonts/fredoka-latin.woff2" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="/css/style.css">

  <!-- Icon-Webfont (~460KB) ist nicht kritisch fuer den ersten Render - asynchron
       nachladen (preload + onload-Swap), damit sie das Rendern des restlichen
       Inhalts nicht blockiert. Icons poppen minimal verzoegert ein, statt die
       ganze Seite zu verzoegern. -->
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.46.0/dist/tabler-icons.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.46.0/dist/tabler-icons.min.css"></noscript>
  {% if jsonLd %}
  <script type="application/ld+json">{{ jsonLd | dump | safe }}</script>
  {% endif %}
  {% if jsonLdFaq %}
  <script type="application/ld+json">{{ jsonLdFaq | dump | safe }}</script>
  {% endif %}
  {% if jsonLdItemList %}
  <script type="application/ld+json">{{ jsonLdItemList | dump | safe }}</script>
  {% endif %}
  {% if jsonLdBreadcrumb %}
  <script type="application/ld+json">{{ jsonLdBreadcrumb | dump | safe }}</script>
  {% endif %}
  {% if jsonLdOrg %}
  <script type="application/ld+json">{{ jsonLdOrg | dump | safe }}</script>
  {% endif %}
</head>
<body>
  <div id="cookie-banner" class="cookie-banner" hidden>
    <p class="cookie-banner-text">
      Wir verwenden Cookies bzw. lokale Speicherung nur, wenn du zustimmst – z. B. für Statistiken (Google Analytics) und eingebettete Karten. Mehr dazu in unserer <a href="/ch/datenschutz/">Datenschutzerklärung</a>.
    </p>
    <div class="cookie-banner-actions">
      <button type="button" id="cookie-decline" class="button button-secondary">Ablehnen</button>
      <button type="button" id="cookie-accept" class="button">Akzeptieren</button>
    </div>
  </div>

  <header class="site-header">
    <a class="logo" href="/ch/">{% optimizedImage "./images/logo.png", "potterymaps Logo", { widths: [452], formats: ["webp", "png"], sizes: "226px", loading: "eager", fetchpriority: "high", class: "logo-img" } %}</a>
    <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menü öffnen">
      <i class="ti ti-menu-2" aria-hidden="true"></i>
    </button>
    <div class="nav-backdrop" id="nav-backdrop" hidden></div>
    <nav id="site-nav">
      <a href="/ch/">Home</a>
      <a href="/ch/alle-staedte/">Alle Städte</a>
      <a href="/ch/events/">Event planen</a>
      <a href="/ch/blog/">Blog</a>
      <a href="/ch/ueber-uns/">Über uns</a>
      <a href="/ch/kontakt/">Kontakt</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <nav>
      <a href="/ch/ueber-uns/">Über uns</a>
      <a href="/ch/kontakt/">Kontakt</a>
      <a href="/ch/datenschutz/">Datenschutzerklärung</a>
      <a href="/ch/impressum/">Impressum</a>
      <a href="#" id="cookie-settings-link">Cookie-Einstellungen</a>
    </nav>
    <p>&copy; {{ year }} potterymaps</p>
  </footer>

  <!-- GA-Tracking-ID: in site/_data/site.js (Feld "gaId") eintragen, sobald
       vorhanden - das Skript wird erst nach "Akzeptieren" im Cookie-Banner
       nachgeladen (siehe /js/consent.js), nie vorab. Leer = Analytics bleibt
       komplett inaktiv. -->
  <script>window.GA_MEASUREMENT_ID = "{{ site.gaId }}";</script>
  <script src="/js/consent.js" defer></script>
  <script src="/js/nav.js" defer></script>
  <script src="/js/gallery.js" defer></script>
</body>
</html>
